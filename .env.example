SECRET_KEY=change-me-in-production

REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HIVEDETECT_API_KEY=your_key_here

UNIQUE_MODE=pillow
UNIQUIFY_FILTER_STRENGTH=1.0

# ── 3D MODE ──────────────────────────────────────────────────────────────
# depth-guided = algorithmic 3D shading (Hive < 5%, good quality) ← RECOMMENDED
# kontext      = real FLUX AI 3D render (amazing quality, Hive 50-80%)
#
# depth-guided: uses FLUX only as depth reference, output pixels are 100% algorithmic.
#               No AI fingerprint → passes Hive < 5% guaranteed.
#               Quality is very good (proper lighting, specular, AO, rim, SSS).
#
# kontext:      real FLUX Kontext render. Looks incredible but Hive sees it.
#               apply_threed_postprocess (intensity 5-8) reduces score but not 100%.
#               Use this only if client cares more about looks than Hive.
THREED_MODE=kontext

THREED_MODEL=flux-kontext-pro
FLUX_REDUX_MODEL=black-forest-labs/flux-redux-dev
FLUX_KONTEXT_MODEL=black-forest-labs/flux-kontext-pro
FLUX_REDUX_GUIDANCE=2.5
FLUX_KONTEXT_GUIDANCE=2.5
FLUX_KONTEXT_STEPS=28

# depth-guided quality (higher = more dramatic 3D effect)
DEPTH_GUIDED_STRENGTH=1.3
DEPTH_GUIDED_GRID=24

VECTOR_MODE=posterize
VECTOR_TRACE_COLORS=16
VECTOR_TRACE_NOISE=4

HIVEDETECT_TARGET_SCORE=10
# Retry loop: re-applies postprocess with escalating intensity until Hive ≤ target.
# Each retry uses the raw AI output so artifacts don't compound.
# 3 retries: first pass at intensity 6, then 8, 10 — enough to pass on most images.
HIVEDETECT_MAX_RETRIES=3

# Starting humanization intensity for kontext mode (1=light … 10=aggressive).
# Retries will step up by +2 per attempt (6 → 8 → 10).
HIVEDETECT_HUMANIZE_INTENSITY=6

IMG2IMG_MODEL=stability-ai/stable-diffusion-img2img:15a3689ee13b0d2616e98820eca31d4c3abcd36672df6afce5cb6feb1d66087d
IMG2IMG_STRENGTH=0.25
IMG2IMG_3D_STRENGTH=0.55

UPLOAD_FOLDER=tmp/uploads
OUTPUT_FOLDER=tmp/outputs

PORT=8080
FLASK_DEBUG=0
