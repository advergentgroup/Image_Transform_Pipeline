# =============================================================================
# Image Transform Pipeline — шаблон конфігурації
# Скопіюй:  copy .env.example .env   (або запусти .\run.ps1)
# =============================================================================

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
PORT=5000
FLASK_DEBUG=0

# ── Папки ────────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=tmp/uploads
OUTPUT_FOLDER=tmp/outputs
SETTINGS_FILE=tmp/settings.json

# ── API ключі ────────────────────────────────────────────────────────────────
# REPLICATE потрібен лише якщо UNIQUE_MODE=flux-redux або sd-img2img
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HIVEDETECT_API_KEY=your_key_here

# ── FLUX generation (product reference + turnaround) ─────────────────────────
FLUX_DEV_MODEL=black-forest-labs/flux-dev
FLUX_DEV_GUIDANCE=3.5
FLUX_DEV_STEPS=35
FLUX_DEV_GO_FAST=0
# OUTPUT_SIZE preset sets reference 9:16 + turnaround 16:9 (see backend/core/output_sizes.py)
# Max preset 4320; default 2880 → reference 2880×5120, turnaround 5120×2880
OUTPUT_SIZE=2880
# jpeg (default) | png
OUTPUT_IMAGE_FORMAT=jpeg
OUTPUT_JPEG_QUALITY=92
REFERENCE_WIDTH=
REFERENCE_HEIGHT=
FLUX_KONTEXT_MODEL=black-forest-labs/flux-kontext-pro
FLUX_KONTEXT_GUIDANCE=2.5
FLUX_KONTEXT_STEPS=28
# Phase 2 turnaround — kontext (vector clipart, default) | lora | qwen | qwen-multi | gpu-worker
# gpu-worker / qwen rotate or reconstruct 3D — bad on flat vector refs; use kontext instead
TURNAROUND_MODE=kontext
QWEN_MULTIANGLE_MODEL=qwen/qwen-edit-multiangle
QWEN_ROTATE_DEGREES=-90,-45,0,45,90
# qwen-multi: views per call (2,3 = 5 views in 2 calls ~$0.06) + chroma-key backdrop
QWEN_MULTI_SPLIT=2,3
QWEN_CHROMA_COLOR=0,177,64

# gpu-worker: rented-GPU service (Zero123++/TRELLIS). Cost = GPU rental only.
# GPU_WORKER_URL=https://your-tunnel-or-forwarded-host:port
GPU_WORKER_TOKEN=
GPU_WORKER_TIMEOUT=180
GPU_WORKER_VIEWS=5
TURNAROUND_SHEET_WIDTH=
TURNAROUND_SHEET_HEIGHT=
FLUX_TURNAROUND_MODEL=black-forest-labs/flux-kontext-pro
FLUX_TURNAROUND_LORA_MODEL=black-forest-labs/flux-kontext-dev-lora
TURNAROUND_LORA_URL=https://huggingface.co/reverentelusarca/kontext-turnaround-sheet-lora-v1/resolve/main/kontext-turnaround-sheet-v1.safetensors
TURNAROUND_LORA_STRENGTH=1.0
REPLICATE_REQUEST_DELAY=11
REPLICATE_RATE_LIMIT_RETRIES=8
REPLICATE_TIMEOUT_SECONDS=600
MAX_FILES_PER_JOB=100
MAX_STYLE_REFS=10
# none = raw FLUX | edge = edge flood + shadow cleanup (default) | illustrator = Image Trace on white
PRODUCT_BG_MODE=edge
PRODUCT_BG_TOLERANCE=40

# ── Legacy uniquify (optional) ─────────────────────────────────────────────
# pillow = no AI | flux-redux | sd-img2img
UNIQUE_MODE=pillow
UNIQUIFY_FILTER_STRENGTH=1.0

# ── Вектор — Adobe Illustrator (Windows) ─────────────────────────────────────
VECTOR_MODE=illustrator
VECTOR_TRACE_COLORS=16
VECTOR_TRACE_NOISE=2
VECTOR_BG_TOLERANCE=40
VECTOR_OUTPUT_MAX_SIDE=2048
ILLUSTRATOR_VISIBLE=0
ILLUSTRATOR_PATH_FIDELITY=95
ILLUSTRATOR_CORNER_FIDELITY=95
ILLUSTRATOR_EXPORT_SCALE=200
ILLUSTRATOR_NOISE_FIDELITY=2
ILLUSTRATOR_TRACING_METHOD=abutting

# ── Hive AI detection ────────────────────────────────────────────────────────
HIVEDETECT_URL=https://api.thehive.ai/api/v3/hive/ai-generated-and-deepfake-content-detection
HIVEDETECT_USE_MOCK=0
HIVEDETECT_TARGET_SCORE=10
HIVEDETECT_MAX_RETRIES=5
HIVEDETECT_HUMANIZE_INTENSITY=6

# ── Legacy Replicate (лише для UNIQUE_MODE=sd-img2img) ───────────────────────
IMG2IMG_MODEL=stability-ai/stable-diffusion-img2img:15a3689ee13b0d2616e98820eca31d4c3abcd36672df6afce5cb6feb1d66087d
IMG2IMG_STRENGTH=0.25
IMG2IMG_3D_STRENGTH=0.55
FLUX_REDUX_MODEL=black-forest-labs/flux-redux-dev
FLUX_REDUX_GUIDANCE=2.5
# PORT=8080
